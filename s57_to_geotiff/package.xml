<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>s57_to_geotiff</name>
  <version>0.0.0</version>
  <description>
    Export ENC (S-57) chart bathymetry as two-band (depth, sigma) GeoTIFFs for
    import into the bathymetry store's chart layer (ADR-0010 D7). CLI tool; no
    dependency on the store library.
  </description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>BSD</license>
  <author>Roland Arsenault</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geographic_msgs</depend>
  <depend>libgdal-dev</depend>
  <depend>marine_autonomy</depend>
  <depend>marine_charts</depend>
  <depend>marine_vertical_datum</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
